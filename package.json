{
  "name": "desktop-downloader",
  "productName": "Desktop Downloader",
  "version": "0.1.0",
  "description": "Cross-platform download manager built on Electron, with aria2c as its download engine (HTTP/HTTPS/FTP/SFTP, BitTorrent, magnet links, Metalink).",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "fetch-binaries": "node --experimental-strip-types scripts/fetch-binaries.mts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run fetch-binaries && electron-vite build && electron-builder",
    "dist:dir": "npm run fetch-binaries && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/lato": "^5.2.0",
    "@fontsource/merriweather": "^5.2.0",
    "@fontsource/montserrat": "^5.2.0",
    "@fontsource/open-sans": "^5.2.0",
    "@fontsource/oswald": "^5.2.0",
    "@fontsource/pt-sans": "^5.2.0",
    "@fontsource/raleway": "^5.2.0",
    "@fontsource/roboto": "^5.2.0",
    "@fontsource/source-sans-3": "^5.2.0",
    "electron-updater": "^6.6.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
